---
import type { CollectionEntry } from "astro:content";
import { type Locale, getLocalizedPath } from "@/i18n/utils";
import { stripBase, stripLocale } from "@/utils/withBase";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

type Props = {
  post?: CollectionEntry<"posts">;
  allPosts?: CollectionEntry<"posts">[];
};

const { post, allPosts } = Astro.props;

const lang = (Astro.currentLocale ?? config.site.lang) as Locale;
const otherLang: Locale = lang === "en" ? "fr" : "en";

let switchHref: string;

if (post && allPosts && post.data.translationKey) {
  // On a post page with a translationKey, try to find its translation
  const translation = allPosts.find(
    p =>
      p.data.translationKey === post.data.translationKey &&
      p.data.lang === otherLang
  );
  if (translation) {
    switchHref = getPostUrl(translation.id, translation.filePath, otherLang);
  } else {
    // No translation found, link to posts list
    switchHref = getLocalizedPath("/posts/", otherLang);
  }
} else if (post) {
  // On a post page without translationKey, link to posts list
  switchHref = getLocalizedPath("/posts/", otherLang);
} else {
  // On any other page, swap the language prefix
  let currentPath = stripLocale(stripBase(Astro.url.pathname), lang);
  // Remove trailing slash
  if (currentPath.endsWith("/") && currentPath !== "/") {
    currentPath = currentPath.slice(0, -1);
  }
  switchHref = getLocalizedPath(currentPath, otherLang);
}

const label = otherLang.toUpperCase();
---

<a
  href={switchHref}
  class="focus-outline p-3 text-sm font-semibold hover:text-accent sm:p-1"
  aria-label={`Switch to ${otherLang === "en" ? "English" : "Français"}`}
>
  {label}
</a>
