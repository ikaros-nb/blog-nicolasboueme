---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import { type Locale, getLocalizedPath } from "@/i18n/utils";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
const privacyHref = getLocalizedPath(
  "/privacy/",
  (Astro.currentLocale ?? config.site.lang) as Locale
);
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="flex flex-col items-center justify-between border-t border-border py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>{t.footer.copyright} &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>{t.footer.allRightsReserved}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <a
        href={privacyHref}
        class="underline-offset-4 hover:text-accent hover:underline"
      >
        {t.footer.privacy}
      </a>
    </div>
  </div>
</footer>
